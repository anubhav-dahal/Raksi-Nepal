PORT=5000
# "memory" = throwaway in-memory MongoDB, re-seeded on every start (dev only).
# For persistent data use a real URI, e.g. mongodb://localhost:27017/raksi_nepal
# or a MongoDB Atlas mongodb+srv:// URI, then run `npm run seed` once.
MONGO_URI=memory
NODE_ENV=development
SEED_ON_START=true

JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Flat delivery fee in whole NPR
DELIVERY_FEE=100

# Address the phone uses to reach this API, for eSewa redirects.
# Leave empty on the same Wi-Fi; set it when using a tunnel or a server.
PUBLIC_URL=

# eSewa ePay v2. Defaults are eSewa's sandbox (EPAYTEST, test money only).
# ESEWA_PRODUCT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# The ONE admin account (any database). Without these, development uses
# a demo admin 9800000000 / admin12345 (in-memory DB only).
# ADMIN_PHONE=98XXXXXXXX
# ADMIN_PASSWORD=choose-a-strong-password

# Folder for admin-uploaded photos (default backend/public/uploads).
# Use a persistent disk in production.
# UPLOAD_DIR=
